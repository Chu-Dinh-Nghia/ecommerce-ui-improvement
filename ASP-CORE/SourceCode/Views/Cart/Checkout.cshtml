@model SourceCode.Models.CheckoutViewModel
@{ ViewData["Title"] = "Thanh toán"; }
<div class="section-heading"><div><span class="eyebrow">Bước cuối</span><h1>Thông tin giao hàng</h1><p>Đơn hàng chỉ dùng dữ liệu thử nghiệm cho bài học.</p></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="panel"><form asp-action="Checkout" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control" /><span asp-validation-for="Mobile" class="text-danger"></span></div><div class="mb-4"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control" rows="3"></textarea><span asp-validation-for="Address" class="text-danger"></span></div><button class="btn btn-gold" type="submit">Xác nhận đặt hàng →</button></form></div></div><div class="col-lg-5"><div class="panel"><span class="eyebrow">Đơn hàng</span><h2 class="mt-2">@Model.Cart.Count sản phẩm</h2>@foreach (var line in Model.Cart.Lines) { <div class="d-flex justify-content-between gap-2 py-2 border-bottom"><span>@line.Movie.Title × @line.Quantity</span><span>@line.Subtotal.ToString("N0")đ</span></div> }<div class="d-flex justify-content-between mt-4"><strong>Tổng cộng</strong><strong class="price">@Model.Cart.Total.ToString("N0")đ</strong></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
