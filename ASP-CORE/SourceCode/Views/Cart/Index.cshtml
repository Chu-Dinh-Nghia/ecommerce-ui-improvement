@model SourceCode.Models.CartViewModel
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="section-heading"><div><span class="eyebrow">Đơn hàng của bạn</span><h1>Giỏ hàng</h1><p>@Model.Count sản phẩm đã chọn</p></div></div>
@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">✦</div><h2>Giỏ hàng đang trống</h2><p class="text-muted">Hãy chọn một bộ phim cho tối nay.</p><a class="btn btn-gold" asp-controller="Movies" asp-action="Index">Khám phá phim →</a></div> }
else { <div class="row g-4"><div class="col-lg-8"><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Phim</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach (var line in Model.Lines) { <tr><td><div class="cart-line"><img class="cart-thumb" src="@line.Movie.PicturePath" alt="" /><a asp-controller="Movies" asp-action="Details" asp-route-id="@line.Movie.Id">@line.Movie.Title</a></div></td><td>@line.Movie.Price.ToString("N0")đ</td><td><form asp-action="Update" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@line.Movie.Id" /><input class="form-control qty-input" type="number" name="quantity" value="@line.Quantity" min="0" max="99" aria-label="Số lượng @line.Movie.Title" /><button class="btn btn-outline-light btn-sm" type="submit">Cập nhật</button></form></td><td>@line.Subtotal.ToString("N0")đ</td><td><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@line.Movie.Id" /><button class="btn btn-link" type="submit" aria-label="Xóa @line.Movie.Title">Xóa</button></form></td></tr> }</tbody></table></div></div><div class="col-lg-4"><div class="panel"><span class="eyebrow">Tóm tắt</span><h2 class="mt-2">Tổng đơn hàng</h2><div class="d-flex justify-content-between my-4"><span>@Model.Count sản phẩm</span><strong class="price">@Model.Total.ToString("N0")đ</strong></div><a class="btn btn-gold w-100" asp-action="Checkout">Tiến hành thanh toán →</a><a class="btn btn-outline-light w-100 mt-2" asp-controller="Movies" asp-action="Index">Tiếp tục chọn phim</a></div></div></div> }
